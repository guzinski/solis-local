# Copy to .env.mobile.local (gitignored). Replace with your actual addresses.
SOLAR_MOBILE_LAN=https://your_home_pc_ip:9443
SOLAR_MOBILE_REMOTE=https://your_vps_ip:9443
SOLAR_MOBILE_PAIRING=http://your_home_pc_ip:3101
# Dashboard stays on its existing port; the gateway never polls the inverter.
SOLAR_MOBILE_UPSTREAM=http://127.0.0.1:3100

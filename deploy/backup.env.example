# Copy to .env.backup.local (ignored by Git). Never put credentials in chat.
BACKUP_DIR=data/backups
BACKUP_KEEP=30
BACKUP_R2_ENABLED=false
# Private bucket, S3 credentials scoped to this bucket with Object Read & Write.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=your-private-backup-bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Configure an R2 lifecycle rule for solar/ to expire remote copies after 90 days.

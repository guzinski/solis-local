# Copy to .env.local (gitignored) and fill in. Never commit real values.
STICK_HOST=your_stick_ip
STICK_PORT=502
STICK_UNIT=1
# Seconds between reads. Values over 60 s get ±10% jitter. The stick's internal
# RS485 schedule is unknown; slower polling is a mitigation experiment.
POLL_SECONDS=300
# Diagnostic experiment: mark an unanswered request at 10s, keep the same
# connection open up to 120s, without resending. Use 10 for the old deadline.
MODBUS_REPLY_TIMEOUT_SECONDS=120
# Optional bounded JSONL trace (4 files of up to ~4 MB). Keep under data/.
MODBUS_TRACE_PATH=data/diagnostics/modbus.jsonl
# Desktop alert after this many minutes without readings in daylight (0 = off).
ALERT_MINUTES=15
PLANT_NAME=My solar plant
# Panel capacity in kWp (on the installer's paperwork or SolisCloud). Optional;
# enables % of capacity and kWh/kWp.
PLANT_KWP=
